{
  "name": "anansi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A memory layer over everything you save, built so your coding agent can query it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jojomensah89/anansi.git"
  },
  "homepage": "https://github.com/jojomensah89/anansi#readme",
  "bugs": {
    "url": "https://github.com/jojomensah89/anansi/issues"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run build && bun run db:migrate:local && wrangler dev --config apps/web/dist/server/wrangler.json",
    "build": "bun run --filter web build:cloudflare",
    "db:generate": "bun run --filter @anansi/db db:generate",
    "db:studio": "bun run --filter @anansi/db db:studio",
    "deploy": "bun run db:migrate:remote && wrangler deploy --config apps/web/dist/server/wrangler.json",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@anansi/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/bun": "1.3.1",
    "@types/node": "catalog:",
    "bun-types": "1.3.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.140.0"
  },
  "overrides": {
    "adm-zip@<0.6.1": "0.6.1",
    "brace-expansion@<1.1.21": "1.1.21",
    "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
    "esbuild@<=0.24.2": "0.25.0",
    "fast-uri@<3.1.8": "3.1.8",
    "hono@<4.13.7": "4.13.7",
    "image-size@<=2.0.2": "2.0.3",
    "ip-address@<=10.7.0": "10.7.1",
    "postcss-selector-parser@<7.1.6": "7.1.6",
    "proxy-addr@<2.0.8": "2.0.8",
    "sharp@<0.35.5": "0.35.5",
    "shell-quote@<1.11.0": "1.11.0",
    "source-map-js@<1.2.2": "1.2.2",
    "undici@<7.29.1": "7.29.1",
    "undici@>=8.0.0 <8.10.2": "8.10.2"
  },
  "cloudflare": {
    "bindings": {
      "ANANSI_SECRET": {
        "description": "Master secret that protects your Anansi deployment across library sign-in, Chrome extension ingestion, and MCP agent access. Generate with `openssl rand -hex 32`."
      }
    }
  }
}
