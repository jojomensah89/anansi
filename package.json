{
  "name": "anansi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A memory layer over everything you save, built so your coding agent can query it.",
  "license": "MIT",
  "packageManager": "bun@1.3.1",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "scripts": {
    "anansi": "bun run apps/cli/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev:web": "turbo run dev -F web --",
    "dev:local": "bun run scripts/dev.ts",
    "build": "turbo run build",
    "db:generate": "turbo run db:generate -F @anansi/db --",
    "db:studio": "bun run --filter @anansi/db db:studio",
    "deploy": "turbo run deploy -F @anansi/infra --",
    "destroy": "turbo run destroy -F @anansi/infra --",
    "dev": "turbo run dev",
    "semantic:local": "bun run scripts/semantic-local-smoke.ts",
    "semantic:ollama": "bun run scripts/semantic-ollama-smoke.ts",
    "ai:tagging:ollama": "bun run scripts/ai-tagging-ollama-smoke.ts",
    "check-types": "turbo run check-types",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@anansi/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anansi/config": "workspace:*",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@huggingface/transformers": "4.2.0",
    "@types/bun": "1.3.1",
    "@types/node": "catalog:",
    "bun-types": "1.3.1",
    "typescript": "^5.9.3",
    "turbo": "^2.10.12",
    "@biomejs/biome": "^2.5.11"
  }
}
