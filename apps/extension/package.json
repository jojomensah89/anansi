{
	"name": "@anansi/extension",
	"description": "manifest.json description",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:private": "bun scripts/private-wxt.ts dev",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:private": "bun scripts/private-wxt.ts build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:private": "bun scripts/private-wxt.ts zip",
		"zip:firefox": "wxt zip -b firefox",
		"check:public-artifact": "bun scripts/check-public-artifact.mjs",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@anansi/sources": "workspace:*",
		"@anansi/ui": "workspace:*",
		"dotenv": "catalog:",
		"linkedom": "^0.18.13",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@wxt-dev/module-react": "^1.1.5",
		"fake-indexeddb": "^6.2.5",
		"typescript": "^5.9.3",
		"web-ext": "^10.5.0",
		"wxt": "^0.21.3"
	}
}
