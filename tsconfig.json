{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    "types": ["bun"]
  },
  "include": ["apps/*/src/**/*.ts", "packages/*/src/**/*.ts", "packages/*/*.config.ts", "packages/*/scripts/**/*.ts", "apps/*/scripts/**/*.ts"]
}
