# Anansi uses your existing provider sessions in the browser; never copy
# provider cookies or auth tokens from DevTools. The secrets below protect
# your own library, extension ingest, and MCP endpoints.

# --- Paths -----------------------------------------------------------------
ANANSI_DATA_DIR=./data

# --- GitHub ----------------------------------------------------------------
# For the optional CLI `anansi import github`. A fine-grained PAT is
# purpose-scoped, read-only, revocable from a
# settings page, carries no session, and is the documented way in.
#
#   https://github.com/settings/personal-access-tokens
#   Repository access: Public repositories  ·  no account permissions needed
GITHUB_TOKEN=

# --- Library server authentication -----------------------------------------
# Generate three independent random secrets. Never put these in VITE_* vars.
# The web connect form exchanges LIBRARY_TOKEN for an HttpOnly session cookie.
LIBRARY_TOKEN=
INGEST_TOKEN=
MCP_TOKEN=

# --- Private extension build -----------------------------------------------
# The extension is built for one personal Anansi deployment. Use the public
# library origin here; API and MCP live below it at /api and /mcp.
ANANSI_EXTENSION_ORIGIN=http://127.0.0.1:3001
# Set this to the same value as INGEST_TOKEN. Dotenv does not interpolate the
# value automatically, so enter it in both places. Never share the built
# extension: this credential is necessarily extractable from its bundle.
ANANSI_EXTENSION_INGEST_TOKEN=
# Local development only; comma-separated exact UI origins, no wildcard.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
