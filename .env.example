# --- X session -------------------------------------------------------------
# Both come from a logged-in x.com tab. In DevTools > Application > Cookies:
#   auth_token  ->  X_AUTH_TOKEN
#   ct0         ->  X_CSRF_TOKEN
#
# These are live credentials for your account. They stay on this machine,
# in this file, which is gitignored. Nothing uploads them anywhere.
X_AUTH_TOKEN=
X_CSRF_TOKEN=

# --- Optional overrides ----------------------------------------------------
# Normally resolved from x.com's bundles and cached in data/x-endpoint.json.
# Set these only to pin a value or to unblock yourself when resolution fails.
# `bun run snippets/resolve.js` in a browser console prints both.
# X_BEARER=
# X_BOOKMARKS_QUERY_ID=

# --- Paths -----------------------------------------------------------------
ANANSI_DATA_DIR=./data
