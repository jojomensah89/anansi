# Copy this file to .env for local development, then set ANANSI_SECRET.
# bun dev applies local D1 migrations and starts http://127.0.0.1:8787.
# D1 and R2 persist in .wrangler/state; this mode does not use data/anansi.db.
# Anansi reads provider sessions from your browser. Never paste provider cookies.

# Master secret protecting library sign-in, extension ingestion, and MCP access.
# Generate with `openssl rand -hex 32`.
ANANSI_SECRET=

# Legacy separate credentials are supported only when ANANSI_SECRET is unset.
# LIBRARY_TOKEN=
# INGEST_TOKEN=
# MCP_TOKEN=

# Private extension build settings. The current build requires both values.
# Set the token to the same ANANSI_SECRET above (or legacy INGEST_TOKEN).
# Rebuild and reload the unpacked extension after changing these settings.
# These values are embedded in the artifact: never distribute this private build.
ANANSI_EXTENSION_ORIGIN=http://127.0.0.1:8787
ANANSI_EXTENSION_INGEST_TOKEN=

# Prefer stored named client keys. Retire shared INGEST_TOKEN/MCP_TOKEN compatibility
# access in Connected clients after migrating browsers and scripts.
