# Anansi needs no credentials for normal use.
#
# Capture happens in your browser: run `anansi ingest`, paste the printed
# snippet into a logged-in x.com tab. The browser uses the session it already
# has. Nothing here is required for that, and nobody should ever be asked to
# copy an auth_token out of DevTools.

# --- Paths -----------------------------------------------------------------
ANANSI_DATA_DIR=./data

# --- GitHub ----------------------------------------------------------------
# For `anansi import github`. Unlike the X cookies below, this one is fine to
# ask for: a fine-grained PAT is purpose-scoped, read-only, revocable from a
# settings page, carries no session, and is the documented way in.
#
#   https://github.com/settings/personal-access-tokens
#   Repository access: Public repositories  ·  no account permissions needed
GITHUB_TOKEN=

# --- R2, for `anansi media sync --r2` --------------------------------------
# Optional. Without these, thumbnails go to data/media/ and everything works.
# R2 is S3-compatible and Bun ships an S3 client, so no dependency is needed.
# Create a bucket and an API token at dash.cloudflare.com > R2.
#
#   R2_ACCOUNT_ID=
#   R2_ACCESS_KEY_ID=
#   R2_SECRET_ACCESS_KEY=
#   R2_BUCKET=

# --- Advanced: headless capture on your own machine ------------------------
# Only for a cron job you run against your own account, where no browser is
# open to paste into. These are live credentials for your whole X account.
# Not a setup step. Not something to document for other people.
#
#   X_AUTH_TOKEN=
#   X_CSRF_TOKEN=

# --- Advanced: pin the endpoint --------------------------------------------
# Normally resolved in-page from the webpack chunks. Set these only to pin a
# value for the headless path above.
#
#   X_BEARER=
#   X_BOOKMARKS_QUERY_ID=
