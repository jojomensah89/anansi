# Anansi uses your existing provider sessions in the browser; never copy
# provider cookies or auth tokens from DevTools. The secret below protects
# your own library, extension ingest, and MCP endpoints.

# --- Paths -----------------------------------------------------------------
ANANSI_DATA_DIR=./data

# --- Server authentication -------------------------------------------------
# Master secret protecting library sign-in, extension ingestion, and MCP access.
# Generate with `openssl rand -hex 32`.
ANANSI_SECRET=

# (Optional backward compatibility overrides)
# LIBRARY_TOKEN=
# INGEST_TOKEN=
# MCP_TOKEN=

# --- Extension configuration (optional) -----------------------------------
# By default, the extension popup allows you to enter your Worker URL and secret
# at runtime. You can optionally pre-bake them for private development builds:
ANANSI_EXTENSION_ORIGIN=http://127.0.0.1:3001
ANANSI_EXTENSION_INGEST_TOKEN=

# Local development only; comma-separated exact UI origins, no wildcard.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

